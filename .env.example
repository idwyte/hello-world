# Copy to .env (which is gitignored) and fill in. All values are public-safe
# (no service-role secrets here — those live in Supabase / RevenueCat /
# Apple Developer dashboards).

# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# Google OAuth (web client id is required for token exchange even on mobile)
# Android: register a separate "Android" OAuth client in Google Cloud
# Console with package name com.honeapp.mobile and the SHA-1 fingerprint
# from `eas credentials` — no extra env var needed at runtime.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Firebase Cloud Messaging (Android only). Path to google-services.json
# relative to the repo root, used by app.config.ts at build time. Leave
# empty during development; set before `eas build --platform android`
# once the Firebase project + google-services.json exist.
GOOGLE_SERVICES_JSON_PATH=
