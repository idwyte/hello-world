{
  "expo": {
    "name": "Nail Shop Simulator",
    "slug": "nail-shop-simulator",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "nailshop",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF0F5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nailshopsimulator.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF0F5"
      },
      "package": "com.nailshopsimulator.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-av",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF0F5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
